# ── Backend Environment Variables ──
PORT=5001

# MongoDB Atlas connection string (required)
# Get free cluster at: https://mongodb.com/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/oviflow

# JWT secret (use a long random string in production)
JWT_SECRET=change_this_to_a_secure_random_string

# Groq AI (LLM) - get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend URL for CORS (comma-separated for multiple)
# Set to your Vercel deployment URL in production
FRONTEND_URL=http://localhost:5173
